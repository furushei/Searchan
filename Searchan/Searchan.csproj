    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <PackageIcon>searchan-icon.png</PackageIcon>
    <ApplicationIcon>searchan.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="searchan-icon.png" />
  </ItemGroup>

</Project>
